DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pbsystem_app
DB_PASSWORD=replace-with-database-password
DB_NAME=pbsystem
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_URL=http://localhost:3000
DEBUG=false

# Per Node process. Stay within the hosting account's MySQL connection quota.
DB_POOL_SIZE=10
DB_POOL_QUEUE_LIMIT=200
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=5000
API_CONCURRENCY_LIMIT=128
HEAVY_CONCURRENCY_LIMIT=2
SLOW_REQUEST_MS=2000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
DB_AUTO_BACKUP=true
# Use persistent absolute directories OUTSIDE public_html for hosting.
# PROFILE_IMAGE_STORAGE_DIR=/home/CPANEL_USER/pbsystem-private/profile-images
# DB_BACKUP_DIR=/home/CPANEL_USER/pbsystem-private/database-backups
# MYSQLDUMP_BIN=/usr/bin/mysqldump
# MYSQL_BIN=/usr/bin/mysql
