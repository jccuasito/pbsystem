# App
APP_URL=http://localhost:3000
JWT_SECRET=generate-a-long-random-secret-at-least-32-characters

# MySQL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pbsystem

# Google Cloud OAuth web client (Authorized JavaScript origins must include APP_URL)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=only-needed-if-you-later-use-google-code-flow
GOOGLE_REDIRECT_URI=http://localhost:3000

# Gmail SMTP: enable 2-Step Verification, then create an App Password
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
